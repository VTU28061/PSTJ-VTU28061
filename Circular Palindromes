import java.io.*;
import java.util.*;

public class Solution {

    
    static void manacher(String s, int[] d1, int[] d2) {

        int n = s.length();

        
        int l = 0;
        int r = -1;

        for (int i = 0; i < n; i++) {

            int k;

            if (i > r) {
                k = 1;
            } else {
                k = Math.min(d1[l + r - i], r - i + 1);
            }

            while (i - k >= 0 &&
                   i + k < n &&
                   s.charAt(i - k) == s.charAt(i + k)) {
                k++;
            }

            d1[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        
        l = 0;
        r = -1;

        for (int i = 0; i < n; i++) {

            int k;

            if (i > r) {
                k = 0;
            } else {
                k = Math.min(d2[l + r - i + 1], r - i + 1);
            }

            while (i - k - 1 >= 0 &&
                   i + k < n &&
                   s.charAt(i - k - 1) == s.charAt(i + k)) {
                k++;
            }

            d2[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }
    }

    public static int[] circularPalindromes(String s) {

        int n = s.length();

        
        String doubled = s + s;

        int len = doubled.length();

        int[] d1 = new int[len];
        int[] d2 = new int[len];

        manacher(doubled, d1, d2);

        int[] answer = new int[n];

      
        for (int start = 0; start < n; start++) {

            int end = start + n - 1;
            int best = 1;

            
            for (int center = start; center <= end; center++) {

                int radius = d1[center];

                int left = center - start + 1;
                int right = end - center + 1;

                int actualRadius =
                    Math.min(radius, Math.min(left, right));

                int length = 2 * actualRadius - 1;

                if (length > best) {
                    best = length;
                }
            }

            
            for (int center = start; center <= end + 1; center++) {

                if (center >= len) {
                    break;
                }

                int radius = d2[center];

                int left = center - start;
                int right = end - center + 1;

                int actualRadius =
                    Math.min(radius, Math.min(left, right));

                if (actualRadius < 0) {
                    actualRadius = 0;
                }

                int length = 2 * actualRadius;

                if (length > best) {
                    best = length;
                }
            }

            answer[start] = best;
        }

        return answer;
    }

    public static void main(String[] args) throws IOException {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());

        String s = br.readLine().trim();

        int[] result = circularPalindromes(s);

        for (int i = 0; i < n; i++) {
            System.out.println(result[i]);
        }

        br.close();
    }
}
