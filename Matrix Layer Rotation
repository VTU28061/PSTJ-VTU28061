import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();

        int[][] matrix = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            ArrayList<Integer> list = new ArrayList<>();

            // Top
            for (int j = layer; j < n - layer; j++)
                list.add(matrix[layer][j]);

            // Right
            for (int i = layer + 1; i < m - layer; i++)
                list.add(matrix[i][n - layer - 1]);

            // Bottom
            for (int j = n - layer - 2; j >= layer; j--)
                list.add(matrix[m - layer - 1][j]);

            // Left
            for (int i = m - layer - 2; i > layer; i--)
                list.add(matrix[i][layer]);

            int size = list.size();
            int rotation = r % size;

            int index = rotation;

            // Top
            for (int j = layer; j < n - layer; j++)
                matrix[layer][j] = list.get(index++ % size);

            // Right
            for (int i = layer + 1; i < m - layer; i++)
                matrix[i][n - layer - 1] = list.get(index++ % size);

            // Bottom
            for (int j = n - layer - 2; j >= layer; j--)
                matrix[m - layer - 1][j] = list.get(index++ % size);

            // Left
            for (int i = m - layer - 2; i > layer; i--)
                matrix[i][layer] = list.get(index++ % size);
        }

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(matrix[i][j]);

                if (j < n - 1)
                    System.out.print(" ");
            }
            System.out.println();
        }
    }
}
